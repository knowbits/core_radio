{
  // ==============================================
  // DOCUMENTATION - "Dev Containers"
  //
  //    Main doc: https://code.visualstudio.com/docs/devcontainers/containers
  //      The "devcontainer.json" SPEC:
  //         https://containers.dev/implementors/json_reference/
  //
  // ==============================================

  "name": "Simple Web Dev (HTML/CSS/JS), nobuild",
  "dockerFile": "Dockerfile",

  "workspaceFolder": "/workspace",
  // OLD: "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

  "remoteUser": "vscode",

  // "postCreateCommand": "mkdir -p ~/.config/fish && cp .devcontainer/config.fish ~/.config/fish/ && fish -c 'source ~/.config/fish/config.fish'",
  // "postCreateCommand": "fish -c 'echo Fish shell setup completed!'",

  "customizations": {
    "vscode": {

      "settings": {

        "git.enabled": false,
        // Automatically fetch commits from the "remote" of the current Github repo:
        "git.autofetch": true,
        // Never open a repository that reside in a parent folder of a workspace or an open file:
        "git.openRepositoryInParentFolders": "never",

        // =============================================
        // Make sure that only the extensions you list in the "extensions" array
        // of your "devcontainer.json" will be available inside the "Dev Container".
        //
        // NOTE: If you have other extensions installed locally or in WSL, they won’t interfere.
        //
        "remote.extensionKind": {
          // Extensions are only enabled within the workspace ("Dev Container"):
          "*": "workspace"
        },

        "files.exclude": {
          "**/.git": true, // Ignore .git folder
          "**/.DS_Store": true // Ignore macOS .DS_Store files
        },

        "files.watcherExclude": {
          // Reduce file system watching overhead.
          // Prevents unnecessary indexing of large directories.
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true
        },

        "terminal.integrated.defaultProfile.linux": "fish",

        // ===========================
        // DEFAULT FORMATTER: Set "Prettier" to be the "default formatter" for all file types:
        "editor.defaultFormatter": "esbenp.prettier-vscode",

        // Default formatters per language
        //
        //"[shellscript]": {
        //  "editor.defaultFormatter": "foxundermoon.shell-format",
        //  "editor.formatOnSave": true
        //},
        //"[dockerfile]": {
        //  "editor.defaultFormatter": "ms-azuretools.vscode-docker",
        //  "editor.formatOnSave": true
        //},

        // =============================================
        // "Cline" AI / LLM extension:

        // "cline.vsCodeLmModelSelector": {
        //    "family": "",
        // },

        // ====================================================
        // "Live Server" extension (Microsoft):
        //
        // USAGE: Open Chrome to view static html page:
        //    http://localhost:45067/core_radio.html
        //    http://localhost:45067/core_radio.html?debug=1
        //
        //    http://localhost:45067/step_2_10__result__html_stripped_and_validated.html
        // ====================================================
        //
        // "Live Server" settings
        "liveServer.settings.port": 45067,
        // The static files of the web app are served using "./src/" as the root folder :
        "liveServer.settings.root": "/src",
        "liveServer.settings.host": "127.0.0.1",
        "liveServer.settings.noBrowser": true,
        "liveServer.settings.ignore": [
          ".vscode/**",
          "**/*.scss",
          "**/*.sass"
        ],
        "liveServer.settings.file": "index.html",
        "liveServer.settings.mount": [
          [ "/build", "./build__electron_app/tmp_html_processing" ],
          [ "/experiments", "./experiments" ]
        ]

      }, // END: settings

      "extensions": [

        // =====================================================
        // "Remote Development" extension pack (Microsft):
        //
        // Contains 4 extensions:
        //    Remote - SSH, Remote - Tunnels, Dev Containers, WSL.
        //
        // An extension pack that lets you open any folder in a: container, on a remote machine, or in WSL.
        //
        // https: //github.com/Microsoft/vscode-remote-release
        // https://code.visualstudio.com/docs/remote/remote-overview
        // https://marketplace.visualstudio.com/items?itemName=ms-vscode-remote.vscode-remote-extensionpack

        // "ms-vscode-remote.vscode-remote-extensionpack", // Remote: Containers, SSH, WSL, Codespaces, and more.

        // =====================================================
        // The "Visual Studio Code Dev Containers" extension does NOT neeed
        // to be installed in the "Dev Container" project!
        //
        // => It is sufficient to install the "Dev Containers" extension  "Locally" (in Windows 11).
        //
        // "ms-vscode-remote.remote-containers",

        // =====================================================
        // The "WSL" extension does not need to be installed in the "Dev Contnainer" project.
        //
        // => It is sufficient to install the "WSL" extension  "Locally" (in Windows 11).
        //    Enables VS CODE to open a repo that resides in WSL 2.
        //
        // "ms-vscode-remote.remote-wsl",


        // =====================================================
        // VS Code Speech:
        // Does not seem to be WORKING in "Dev Container" project.
        //
        // "ms-vscode.vscode-speech",

        // =====================================================
        // AI / LLM tools:

        // LLM: Cline:
        "saoudrizwan.claude-dev", // Cline: coding agent that uses "Claude 3.5 Sonnet"
        //    https://cline.bot
        //    https://github.com/cline/cline
        //    https://marketplace.visualstudio.com/items?itemName=saoudrizwan.claude-dev

        // LLM: Github Copilot
        // "GitHub.copilot@prerelease", // Github Copilot
        // "GitHub.copilot-chat@prerelease", // Github Copilot Chat

        // LLM: Continue:
        // "continue.continue", // https: //marketplace.visualstudio.com/items?itemName=Continue.continue

        // Docker, remote (SSH etc):
        "ms-azuretools.vscode-docker", // Docker tools by Microsoft.
        // 		https://marketplace.visualstudio.com/items?itemName=ms-azuretools.vscode-docker
        // "ms-vscode-remote.remote-ssh",  // Remote SSH


        // Icon themes
        "vscode-icons-team.vscode-icons",
        // "pkief.material-icon-theme", 	// Material Design Icons.
        //     https://marketplace.visualstudio.com/items?itemName=PKief.material-icon-theme

        // Coding productivity tools:
        "christian-kohler.path-intellisense", // Path Intellisense: path autocompletion
        "usernamehw.errorlens", // Error Lens: Highlights errors and warnings in the code
        "formulahendry.code-runner", // Code Runner: Ctrl+Alt+N: Run code file of current active Text Editor
        //    https://marketplace.visualstudio.com/items?itemName=formulahendry.code-runner
        // "Wattenberger.footsteps", // Footsteps: Navigate back to where you were working: ctrl+alt+left/right

        // Git related tools:
        // "eamodio.gitlens", // GitLens: Git supercharged
        // "GitHub.vscode-pull-request-github", // GitHub Pull Requests: Review and manage GitHub pull requests directly in VS Code
        // "vivaxy.vscode-conventional-commits", // Conventional Commits: https://www.conventionalcommits.org

        // Web dev:
        "esbenp.prettier-vscode", // Prettier
        "ms-vscode.live-server",
        "ecmel.vscode-html-css", // HTML and CSS support: Enhances IntelliSense and autocomplete features for HTML and CSS.
        "pranaygp.vscode-css-peek", // CSS Peek: Peek / Hover / Go To for  "CSS selector" definitions (classes, IDs, HTML tags).

        // Javascript:
        // "ms-vscode.js-debug",  // NOTE: "js-debug" is already installed in VS Code.
        //    Debugs: Node.js, Chrome, Edge, WebView2, VS Code extensions, Blazor, React Native, and more.
        //    It is the default JavaScript debugger in VS Code.
        // 	  https://marketplace.visualstudio.com/items?itemName=ms-vscode.js-debug
        // "dbaeumer.vscode-eslint",	// Javascript: ESLint: Requires "npm" installation of eslint packages
        // "ms-vscode.js-debug-companion",
        //
        // Is "IntelliSense: NEEDED/SMART when using Github Copilot? :
        // "visualstudioexptteam.vscodeintellicode", // AI-assisted IntelliSense: Javascript, Java, Python.
        //      https://marketplace.visualstudio.com/items?itemName=VisualStudioExptTeam.vscodeintellicode

        // REST, POST tools:
        // "rangav.vscode-thunder-client",  // Thunder Client: Lightweight Rest API Client for quick API testing
        "humao.rest-client", // REST CLient: Write requests in plain text files.
        //     https://marketplace.visualstudio.com/items?itemName=humao.rest-client

        // MarkDown related:
        "yzhang.markdown-all-in-one", // Markdown All in One
        "DavidAnson.vscode-markdownlint", // Markdown linting and style checking for Visual Studio Code

        // Bash related:
        "mads-hartmann.bash-ide-vscode", // Bash: A language server for Bash. IntelliSense, linting, and debugging.
        // "timonwong.shellcheck", 		 // Bash: shellcheck tool. TODO: Needs to install "shellcheck: in the Dockerfile image

        // TODO, FIXME etc
        "wayou.vscode-todo-highlight", // TODO Highlight
        // "Gruntfuggly.todo-tree",

        // Misc useful tools
        // "chrmarti.regex",
        "redhat.vscode-yaml", // YAML Language Support by Red Hat
        "tamasfe.even-better-toml", // .toml files
        "nefrob.vscode-just-syntax" // Justfile: Syntax etc for "Just" make files
        // "mechatroner.rainbow-csv",  // Rainbow CSV: Highlight CSV and TSV files, Run SQL-like queries.
        // 		https://marketplace.visualstudio.com/items?itemName=mechatroner.rainbow-csv

        // Collaboration tools
        // "ms-vsliveshare.vslives",   // Live Share: Real-time collaborative development. Pair programming etc.

        // Diagrams etc
        // "pomdtr.excalidraw-editor", Excalidraw : https://marketplace.visualstudio.com/items?itemName=pomdtr.excalidraw-editor

        // Te "Workspace Explorer" extensions
        // "tomsaunders-code.workspace-explorer",   // Browse, open, and manage your VSCode workspaces in this simple view.
        //     https://github.com/sirfuzzalot/workspace-explorer
        //     https://marketplace.visualstudio.com/items?itemName=tomsaunders-code.workspace-explorer

      ] // END: extensions
    } // END: vscode
  } // END: customizations

}
