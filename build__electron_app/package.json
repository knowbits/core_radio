{
  "name": "core-radio",
  "version": "0.1.11",
  "description": "Core Radio - A simple radio for listening to your favourite audio streams",
  "author": "Erlend Bleken <1571664+knowbits@users.noreply.github.com>",
  "license": "MIT",
  "main": "main.js",
  "build": {
    "appId": "org.bleken.coreRadio",
    "productName": "Core Radio",
    "compression": "maximum",
    "artifactName": "${name}_${version}_${env.TARGET_PLATFORM}_${arch}.${ext}",
    "win": {
      "icon": "icons/favicon_256x256.ico",
      "target": [
        {
          "target": "nsis"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "icons/mac_icon.icns",
      "target": "zip"
    },
    "linux": {
      "icon": "icons/linux_icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/*"
    ]
  },
  "scripts": {
    "test": "jest",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "dist-all-platforms": "TARGET_PLATFORM=ALL electron-builder --mac --win --linux",
    "dist-all-platforms-and-architectures": "TARGET_PLATFORM=ALL electron-builder --mac --win --linux --x64 --arm64",
    "dist-linux-all": "TARGET_PLATFORM=linux electron-builder --linux --x64 --arm64",
    "dist-linux-Intel-x64": "TARGET_PLATFORM=linux electron-builder --linux --x64",
    "dist-linux-ARM64": "TARGET_PLATFORM=linux electron-builder --linux --arm64",
    "dist-windows-x64": "TARGET_PLATFORM=windows electron-builder --windows --x64",
    "dist-mac-on-Intel": "TARGET_PLATFORM=mac electron-builder --mac --x64",
    "dist-mac-on-M1": "TARGET_PLATFORM=mac electron-builder --mac --arm64",
    "dist-mac-on-Intel-and-M1": "TARGET_PLATFORM=mac electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "path": "^0.12.7",
    "prettier": "^3.9.10"
  }
}
