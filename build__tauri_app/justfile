# justfile

# ==============================================================================
# How to use "just" :
# Run these commands with "just <command>".
# For example: "just start" => To start the Tauri app locally.
# ==============================================================================

# ==============================================================================
# INSTALL:
#
# 1. Use "cargo" to install "just", since it is a Rust app
#   $ sudo apt update; sudo apt install rustc
#   $ cargo install just
#
# 2. Add to ~/.bashrc or ~/.zshrc:
#   export PATH="$HOME/.cargo/bin:$PATH"
#
# 3. Verify version:
#    $ just --version""
#    Check against latest release: https://github.com/casey/just
# ==============================================================================

TAURI_BUILD_DIR := "./"

# Install dependencies
install:
    cd {{TAURI_BUILD_DIR}} && npm install

# Start the Tauri app locally
start:
    cd {{TAURI_BUILD_DIR}} && npm run tauri dev

# Build the Tauri app for different platforms and architectures
# (Tauri builds for the host OS only: run build-windows on Windows, build-mac on macOS.)
build-linux:
    cd {{TAURI_BUILD_DIR}} && npm run tauri build -- --bundles deb,appimage

build-windows:
    cd {{TAURI_BUILD_DIR}} && npm run tauri build -- --target x86_64-pc-windows-msvc

build-mac:
    cd {{TAURI_BUILD_DIR}} && npm run tauri build -- --target aarch64-apple-darwin

# Clean the project
clean:
    cd {{TAURI_BUILD_DIR}} && rm -f core_radio__processed_for_tauri_app.html
    cd {{TAURI_BUILD_DIR}} && rm -rf tmp_html_processing
    cd {{TAURI_BUILD_DIR}} && rm -rf dist

# Test the project: lint the Rust side (there are no JavaScript tests)
test: install
    cd {{TAURI_BUILD_DIR}}/src-tauri && cargo clippy --all-targets -- -D warnings
