{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/favicon_256x256.ico"
    ],
    "resources": [
      "./WebView2Loader.dll"
    ]
  },
  "productName": "core-radio",
  "mainBinaryName": "core-radio",
  "version": "0.1.3",
  "identifier": "com.core-radio",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Core Radio",
        "fullscreen": false,
        "resizable": true,
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
